# mod_php + Apache with AddressSanitizer (build on pluto with network, load tar into guest).
ARG PHP_VERSION=8.4.26
FROM docker.io/library/php:${PHP_VERSION}-apache-bookworm AS build

ARG PHP_VERSION
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang-16 llvm-16 \
    $PHPIZE_DEPS \
    libasan8 \
    gdb procps lsof strace \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang-16
ENV CXX=clang++-16
ENV CFLAGS="-fsanitize=address -fno-omit-frame-pointer -g -O1"
ENV CXXFLAGS="$CFLAGS"
ENV LDFLAGS="-fsanitize=address"
ENV LIBS="-lasan"

# Rebuild embedded PHP (libphp) using the same tree shipped in official images.
WORKDIR /usr/src/php

RUN ./buildconf --force 2>/dev/null || true \
    && ./configure \
      --build="$(uname -m)-linux-gnu" \
      --with-apxs2=/usr/bin/apxs2 \
      --disable-cgi \
      --enable-mysqlnd \
      --with-pdo-mysql=mysqlnd \
      --with-mysqli=mysqlnd \
      --with-pdo-sqlite \
      --with-sqlite3 \
      --enable-soap \
      --enable-intl \
      --with-openssl \
      --with-zlib \
      --enable-bcmath \
      --with-gettext \
      --enable-session \
      --enable-ftp \
      --enable-mbstring \
      --enable-option-checking=fatal \
    && make -j"$(nproc)" \
    && make install \
    && cp -a modules/libphp*.so /usr/lib/apache2/modules/ 2>/dev/null || true \
    && apachectl -M | grep php || apache2ctl -M | grep php

# Runtime helpers for wedge capture inside the container.
RUN apt-get update && apt-get install -y --no-install-recommends gdb procps lsof strace \
    && rm -rf /var/lib/apt/lists/*

ENV ASAN_OPTIONS=detect_leaks=1:abort_on_error=0:symbolize=1
ENV LSAN_OPTIONS=verbosity=0
