<!-- Isolated libvirt network for the blackhole research VM (no upstream route). -->
<network>
  <name>blackhole</name>
  <uuid>8f3c2a1b-4d5e-6f70-8192-blackhole0001</uuid>
  <bridge name="virbr-blackhole" stp="on" delay="0"/>
  <domain name="blackhole"/>
  <forward mode="none"/>
  <ip address="192.168.100.1" netmask="255.255.255.0">
    <dhcp>
      <range start="192.168.100.128" end="192.168.100.254"/>
    </dhcp>
  </ip>
</network>
